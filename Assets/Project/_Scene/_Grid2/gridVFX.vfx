  stickyNoteInfos:
  - title: "\uC758\uC0AC\uCF54\uB4DC"
    position:
      serializedVersion: 2
      x: -1540
      y: 2142
      width: 277
      height: 508
    contents: "// \uCD08\uAE30\uAC12\r\nincubePrev = incube\r\nenterAge = -1\r\nexitAge
      = -1\r\nalphaLerp = start\r\n\r\n// 1. \uBCC0\uD654 \uC2DC\uC810 \uC800\uC7A5\r\nif
      (incube && !incubePrev) {\r\n    enterAge = Age\r\n} else {\r\n    enterAge
      = enterAge\r\n}\r\n\r\nif (!incube && incubePrev) {\r\n    exitAge = Age\r\n}
      else {\r\n    exitAge = exitAge\r\n}\r\n\r\n// 2. \uC54C\uD30C \uACC4\uC0B0\r\nif
      (incube) {\r\n    t = saturate((Age - enterAge) / duration)\r\n    alphaLerp
      = 1 - t\r\n} else {\r\n    if (!incube && exitAge > -1) {\r\n        t = saturate((Age
      - exitAge) / duration)\r\n        alphaLerp = t\r\n    } else {\r\n       
      alphaLerp = start\r\n    }\r\n}\r\n\r\n// 3. \uC774\uC804 \uC0C1\uD0DC \uC800\uC7A5\r\nincubePrev
      = incube"
    theme: Classic
    textSize: Small
  categories:
  - name: axis
    collapsed: 1
  - name: collider
    collapsed: 1
  uiBounds:
    serializedVersion: 2
    x: -1540
    y: -309
    width: 3670
    height: 3532
